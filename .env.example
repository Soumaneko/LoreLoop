# OpenAI API 配置
# 可选：必须是绝对路径；未设置时使用系统的 LoreLoop 用户数据目录
# LORELOOP_DATA_DIR=/custom/path
OPENAI_API_KEY=sk-your-key-here
# Base URL 可选：留空表示使用所选协议的官方默认地址；
# 只有需要网关/代理（OpenCode Go 等）时才填写。
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_THINKING=disabled
# LLM wire protocol: openai_responses | openai_chat | anthropic_messages | gemini
# 旧配置缺省为 openai_chat；不得按 URL 猜测协议。
OPENAI_PROTOCOL=openai_chat
